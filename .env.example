# Supabase — from your project's Settings > API. Use a dev/test project
# until you're ready to go live; nothing here should be a production key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — bypasses RLS. Never prefix with NEXT_PUBLIC_, never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — test-mode keys (sk_test_ / pk_test_) until launch.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
